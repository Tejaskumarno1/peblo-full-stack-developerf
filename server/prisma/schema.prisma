generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
  // Generated inside the project (not node_modules/.prisma) so the desktop packager ships it.
  output   = "../generated/prisma"
  // One engine per kind of computer we ship to: the installers are built on one machine for all of them (PEB-71).
  // electron/engine.cjs picks the matching file at start-up.
  binaryTargets = ["native", "windows", "darwin", "darwin-arm64", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  extensions = [citext]
}

model User {
  id           String   @id @default(uuid())
  name         String   @default("You")
  email        String   @unique @db.Citext
  passwordHash String   @map("password_hash")
  tokenVersion Int      @default(0) @map("token_version")

  // Profile & Settings
  jobTitle     String?  @map("job_title")
  bio          String?  @db.Text
  timezone     String   @default("UTC")
  settings     Json

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  notes         Note[]
  tags          Tag[]
  aiGenerations AiGeneration[]
  todos         Todo[]
  todoSeries    TodoSeries[]
  apiKeys       UserApiKeys?
  quizRuns      QuizRun[]
  mastery       TopicMastery[]
  apiTokens     ApiToken[]

  @@map("users")
}

model Note {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  title      String   @default("Untitled") @db.Text
  content    String   @default("") @db.Text
  category   String?
  isArchived Boolean  @default(false) @map("is_archived")
  isDeleted  Boolean  @default(false) @map("is_deleted")
  deletedAt  DateTime? @map("deleted_at")
  meta       Json?
  shareToken String? @unique @map("share_token")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tags          NoteTag[]
  aiGenerations AiGeneration[]
  backups       NoteBackup[]
  linkedTodos   Todo[]
  embedding     NoteEmbedding?

  @@index([userId])
  @@index([userId, isArchived])
  @@index([userId, isDeleted])
  @@index([userId, category])
  @@index([userId, updatedAt(sort: Desc)])
  @@map("notes")
}

// Each user has their own tags, so two people can both have a "work" tag without colliding.
model Tag {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  name      String   @db.Citext
  createdAt DateTime @default(now()) @map("created_at")

  user  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  notes NoteTag[]

  @@unique([userId, name])
  @@map("tags")
}

model NoteTag {
  noteId String @map("note_id")
  tagId  String @map("tag_id")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([tagId])
  @@map("note_tags")
}

model AiGeneration {
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  userId    String   @map("user_id")
  type      String
  result    String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([noteId])
  @@map("ai_generations")
}

model NoteBackup {
  id        String   @id @default(uuid())
  noteId    String   @map("note_id")
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)

  @@index([noteId, createdAt])
  @@map("note_backups")
}

model Todo {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  text      String    @db.Text
  completed Boolean   @default(false) @map("is_completed")
  priority  String    @default("medium")
  deadline  DateTime? @map("deadline")
  todoTags   Json      @map("tags")
  noteId     String?   @map("linked_note_id")
  startTime  String?   @map("start_time")
  endTime    String?   @map("end_time")
  recurrence String?   @default("none") @map("recurrence")
  seriesId   String?   @map("series_id")
  meta       Json?
  shareToken String? @unique @map("share_token")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user   User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  note   Note?       @relation(fields: [noteId], references: [id], onDelete: SetNull)
  series TodoSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([userId, deadline])
  @@index([userId, completed])
  @@index([seriesId])
  @@map("todos")
}

/// A repeating task: the rule and the task details. Its occurrences are todos with this seriesId.
model TodoSeries {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  recurrence    String
  timezone      String    @db.VarChar(64)
  anchor        DateTime
  lastGenerated DateTime  @map("last_generated")
  endedAt       DateTime? @map("ended_at")
  text          String    @db.Text
  priority      String    @default("medium")
  todoTags      Json      @map("tags")
  startTime     String?   @map("start_time")
  endTime       String?   @map("end_time")
  noteId        String?   @map("linked_note_id")
  createdAt     DateTime  @default(now()) @map("created_at")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  todos Todo[]

  @@index([userId])
  @@map("todo_series")
}

model NoteEmbedding {
  id        String   @id @default(uuid())
  noteId    String   @unique @map("note_id")
  vector    String   @db.Text // JSON stringified float array representing embedding values
  createdAt DateTime @default(now()) @map("created_at")

  note Note @relation(fields: [noteId], references: [id], onDelete: Cascade)
  @@map("note_embeddings")
}

model UserApiKeys {
  userId         String   @id @map("user_id")
  openAiKey      String?  @map("openai_key") @db.Text
  geminiKey      String?  @map("gemini_key") @db.Text
  groqKey        String?  @map("groq_key") @db.Text
  huggingFaceKey String?  @map("huggingface_key") @db.Text
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_api_keys")
}


// Orbit style: a quiz made from one topic's notes (questions and answers as JSON).
model QuizRun {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  topic      String   @db.Citext
  questions  String    @db.Text
  answers    String?   @db.Text
  correct    Int?
  total      Int
  createdAt  DateTime  @default(now()) @map("created_at")
  finishedAt DateTime? @map("finished_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, topic])
  @@map("quiz_runs")
}

// How well a topic (a tag) is known, 0–100, from the quizzes taken on it.
model TopicMastery {
  userId      String   @map("user_id")
  topic       String   @db.Citext
  score       Int
  quizzes     Int      @default(0)
  lastCorrect Int      @default(0) @map("last_correct")
  lastTotal   Int      @default(0) @map("last_total")
  missed      String   @default("[]") @db.Text
  updatedAt   DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, topic])
  @@map("topic_mastery")
}

// A personal access token: lets another program (the Peblo MCP server, a script) act for one account.
// Only a SHA-256 of the token is stored; the token itself is shown once, when it is made.
model ApiToken {
  id         String    @id @default(uuid())
  userId     String    @map("user_id")
  name       String
  tokenHash  String    @unique @map("token_hash")
  prefix     String
  scope      String    @default("full")
  createdAt  DateTime  @default(now()) @map("created_at")
  lastUsedAt DateTime? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("api_tokens")
}
