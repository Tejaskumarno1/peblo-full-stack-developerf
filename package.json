{
  "name": "peblo",
  "productName": "Peblo",
  "version": "1.0.4",
  "private": true,
  "type": "module",
  "description": "Peblo — AI-powered notes, to-dos and calendar that runs on your computer",
  "license": "MIT",
  "author": {
    "name": "Boddu Tejas Kumar",
    "email": "boddutejaskumar@gmail.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -k -n server,client,app -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:app\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:app": "wait-on tcp:3001 http-get://localhost:5173 && cross-env PEBLO_DEV_URL=http://localhost:5173 electron .",
    "build:client": "npm --prefix client run build",
    "build:server": "node scripts/build-server.mjs",
    "typecheck": "tsc -p server --noEmit",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "serve": "node dist/server/index.js",
    "mcp": "node dist/server/mcp/index.js",
    "db:sql": "node scripts/make-sql.mjs",
    "seed": "tsx scripts/seed.ts",
    "test": "npm run build:server && node scripts/smoke-test.mjs && node scripts/connections-unit.mjs && node scripts/uninstall-unit.mjs && node scripts/connections-test.mjs && node scripts/account-test.mjs",
    "check:canvas": "node scripts/run-canvas-check.mjs",
    "e2e": "node scripts/run-e2e.mjs",
    "encrypt:existing": "node scripts/encrypt-existing.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@prisma/client": "^6.2.0",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "diff-match-patch": "^1.0.5",
    "dotenv": "^16.4.7",
    "electron-updater": "^6.8.11",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.3",
    "lib0": "^0.2.119",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.5",
    "ws": "^8.18.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/diff-match-patch": "^1.0.36",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "docx": "^9.0.2",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "pptxgenjs": "^3.12.0",
    "prisma": "^6.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "dev.peblo.app",
    "productName": "Peblo",
    "publish": [
      {
        "provider": "github",
        "owner": "Tejaskumarno1",
        "repo": "peblo-full-stack-developerf",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.png",
      "dist/server/**/*",
      "server/prisma/sql/**/*",
      "server/generated/prisma/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/prisma/**/*",
      "!node_modules/@prisma/engines/**/*"
    ],
    "asarUnpack": [
      "server/generated/prisma/**/*",
      "server/prisma/sql/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false,
      "include": "build/installer.nsh",
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Peblo",
      "uninstallDisplayName": "Peblo",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "artifactName": "Peblo-Setup-${version}.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Boddu Tejas Kumar <boddutejaskumar@gmail.com>"
    },
    "afterPack": "build/afterPack.cjs",
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableCookieEncryption": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "electron-winstaller@5.4.0": true,
    "@prisma/engines@6.19.3": true,
    "electron@44.4.5": true
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
