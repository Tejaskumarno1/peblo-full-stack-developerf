{
  "name": "peblo",
  "productName": "Peblo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Peblo — AI-powered notes, to-dos and calendar that runs on your computer",
  "author": {
    "name": "Boddu Tejas Kumar",
    "email": "boddutejaskumar@gmail.com"
  },
  "main": "electron/main.cjs",
  "scripts": {
    "postinstall": "prisma generate --schema server/prisma/schema.prisma",
    "install:all": "npm install && npm --prefix client install",
    "dev": "concurrently -k -n server,client,app -c blue,green,magenta \"npm:dev:server\" \"npm:dev:client\" \"npm:dev:app\"",
    "dev:server": "tsx watch server/src/index.ts",
    "dev:client": "npm --prefix client run dev",
    "dev:app": "wait-on tcp:3001 http-get://localhost:5173 && cross-env PEBLO_DEV_URL=http://localhost:5173 electron .",
    "build:client": "npm --prefix client run build",
    "build:server": "node scripts/build-server.mjs",
    "build": "npm run build:client && npm run build:server",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "db:sql": "prisma migrate diff --from-empty --to-schema-datamodel server/prisma/schema.prisma --script",
    "test": "npm run build:server && node scripts/smoke-test.mjs",
    "check:canvas": "node scripts/run-canvas-check.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^6.2.0",
    "adm-zip": "^0.6.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^2.1.1",
    "openai": "^6.39.0",
    "pdf-parse": "^1.1.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.0.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "concurrently": "^9.1.2",
    "cross-env": "^10.0.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "prisma": "^6.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.10"
  },
  "build": {
    "appId": "dev.peblo.app",
    "productName": "Peblo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "build/icon.png",
      "dist/server/**/*",
      "server/prisma/sql/**/*",
      "server/generated/prisma/**/*",
      "client/dist/**/*",
      "node_modules/**/*",
      "package.json",
      "!**/*.map",
      "!node_modules/.cache/**/*",
      "!node_modules/electron/**/*",
      "!node_modules/prisma/**/*",
      "!node_modules/@prisma/engines/**/*"
    ],
    "asarUnpack": [
      "server/generated/prisma/**/*",
      "server/prisma/sql/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Peblo",
      "artifactName": "Peblo-${version}-win-x64.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "icon": "build/icon.png"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Office",
      "icon": "build/icon.png",
      "maintainer": "Boddu Tejas Kumar <boddutejaskumar@gmail.com>"
    }
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true,
    "prisma@6.19.3": true,
    "electron-winstaller@5.4.0": true,
    "@prisma/engines@6.19.3": true,
    "electron@44.4.5": true
  }
}
