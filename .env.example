# Copy to server/.env (dev) or set these in your hosting platform's dashboard (production).

# Required. Postgres connection string. Supabase: Connect > Session pooler (port 5432), copy the URI and put your
# database password in. Keep this file private: it is in .gitignore.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-ap-northeast-2.pooler.supabase.com:5432/postgres

# Required. Signs login sessions (JWTs). Use a long random string in production —
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional. Secret used to encrypt users' saved AI keys in the database. Defaults to JWT_SECRET.
# Changing it (or JWT_SECRET, if this is unset) makes already-saved keys unreadable, so users re-enter them.
KEY_ENCRYPTION_SECRET=

# Hosting only: set NODE_ENV=production, and PORT / HOST if your platform needs them.
# TRUST_PROXY=1 when the server sits behind the platform's proxy (so rate limits see real client addresses).
NODE_ENV=
TRUST_PROXY=

# Comma-separated list of extra origins allowed to call this API (a hosted web client's
# URL, say). localhost and the Electron app are always allowed; this is for anything else.
ALLOWED_ORIGINS=

# Optional fallback AI keys for development. Normally users paste their own in
# Settings -> AI Providers, saved per-account in the database.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Several Gemini keys, comma-separated; used in turn when one hits its limit.
GEMINI_API_KEYS=
# Set to "off" on a shared host so users can only use their own saved keys (the keys above are ignored).
SERVER_AI_KEYS=

# Rate limits (all optional). Counts are kept in memory and reset when the server restarts.
# API_RATE_MAX: requests per minute per address (default 1200). AI_BURST_MAX: AI calls per minute per user (20).
# AI_DAILY_LIMIT: AI calls per user per rolling 24 h (500). 0 turns a limit off. SIGNUP_RATE_MAX: sign-ups per hour per address.
API_RATE_MAX=
AI_BURST_MAX=
AI_DAILY_LIMIT=
SIGNUP_RATE_MAX=

# Local AI (Ollama). OLLAMA_URL defaults to http://127.0.0.1:11434; OLLAMA_ALLOWED_HOSTS lists extra hosts users may point at.
OLLAMA_URL=
OLLAMA_ALLOWED_HOSTS=

# Server and desktop app paths (rarely needed).
# HOST / PORT: where the server listens. PEBLO_STATIC_DIR: folder with the built client.
# PEBLO_API_URL: make the desktop app use a hosted server instead of starting its own.
# PEBLO_ENV_FILE: read settings from this file. An installed app otherwise reads <userData>/.env.
# PEBLO_DATA_DIR: where the app keeps local files.
HOST=
PORT=
PEBLO_STATIC_DIR=
PEBLO_API_URL=
PEBLO_ENV_FILE=
PEBLO_DATA_DIR=

# Email (confirmation links). Paste a Gmail App Password into SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=tejaskumarwgl@gmail.com
SMTP_PASS=
MAIL_FROM=Peblo <tejaskumarwgl@gmail.com>
PUBLIC_URL=https://peblo-stxo.onrender.com
