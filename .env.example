# Copy to server/.env (dev) or set these in your hosting platform's dashboard (production).

# Required. MySQL connection string. Local: create a database and user in MySQL Workbench,
# then use mysql://USER:PASSWORD@localhost:3306/peblo
DATABASE_URL=mysql://peblo:your_password@localhost:3306/peblo

# Required. Signs login sessions (JWTs). Use a long random string in production —
# generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of extra origins allowed to call this API (a hosted web client's
# URL, say). localhost and the Electron app are always allowed; this is for anything else.
ALLOWED_ORIGINS=

# Optional fallback AI keys for development. Normally users paste their own in
# Settings -> AI Providers, saved per-account in the database.
OPENAI_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
